DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration
# Use SQLite by default for local validation. Set DB_ENGINE=mysql and provide the
# actual MySQL username/password when a real database server is available.
DB_ENGINE=sqlite3
DB_NAME=nexora_db
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_HOST=127.0.0.1
DB_PORT=3306

# AI Configuration
# AI_PROVIDER determines which LLM backend to use.
# Current implementation: 'mock' (deterministic, no API credentials required)
# Future providers: 'gemini', 'openai', etc.
AI_PROVIDER=mock
# AI_API_KEY: API key for the selected provider (leave empty for mock provider)
AI_API_KEY=
# AI_MODEL: Model name for the selected provider (optional, provider-specific)
AI_MODEL=
# AI_TIMEOUT_SECONDS: How long to wait for AI provider response (default: 15)
AI_TIMEOUT_SECONDS=15
# AI_MAX_RETRIES: Number of retries if provider fails (default: 2)
AI_MAX_RETRIES=2

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
