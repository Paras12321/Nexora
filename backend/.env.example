DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Use SQLite by default for local validation. Set DB_ENGINE=mysql and provide the
# actual MySQL username/password when a real database server is available.
DB_ENGINE=sqlite3
DB_NAME=nexora_db
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_HOST=127.0.0.1
DB_PORT=3306

AI_PROVIDER=mock
AI_API_KEY=change-me-in-production
AI_TIMEOUT_SECONDS=15
AI_MAX_RETRIES=2

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
